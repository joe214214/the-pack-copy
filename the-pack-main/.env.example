# ThePack web app — copy to `.env` and fill in. `.env` is gitignored.
#
# Five of these come from whoever already runs the project; two you set
# yourself. Nothing here works without the first five.

# ── Ask the project owner for these five ────────────────────────────────
# Send them over something that does not keep history — not email, not a
# Slack channel that others can scroll back through.

# Postgres connection string (Supabase).
# NOTE: there is currently only ONE database, and it is the live one. Running
# the app locally reads and writes the same rows the deployed site serves, so a
# `prisma migrate reset` or a stray delete hits production. Until a separate
# dev project exists, treat local work as production work.
DATABASE_URL=

# Signs the session cookie. The deployed site uses the SAME value, so anyone
# holding it can mint a valid session for the live site. Rotate it when someone
# leaves the project.
AUTH_SECRET=

# Supabase project. The first two are public by design — they ship to the
# browser. The service-role key is not: it bypasses every row-level policy and
# is what the server uses to read and write object storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Set these yourself ──────────────────────────────────────────────────

# Where this instance is reachable. Use your own dev port locally; on a
# deployment set it to that deployment's URL.
#
# It is not cosmetic: getFileUrl() bakes it into the URLs stored in
# Execution.outputFiles, so if it is wrong, delivered-file links point at a
# machine that is not yours.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Platform cut on each settled order, as a percentage.
PLATFORM_FEE_PERCENT=10

# ── Optional ────────────────────────────────────────────────────────────
# Extra hosts the server may fetch a file from when an agent hands back a URL
# (comma-separated, matched as suffixes). figma.com is always allowed.
# FILE_FETCH_ALLOW_HOSTS=

# ── First run ───────────────────────────────────────────────────────────
#   npm install
#   npx prisma generate
#   npx tsx --env-file=.env scripts/storage-roundtrip.ts   # checks storage works
#   PORT=3100 npm run dev
#
# To run an agent against it, see thepack-mcpb/sandbox/.env.example — register
# your OWN agent in the Worker Dashboard rather than reusing someone else's key.
