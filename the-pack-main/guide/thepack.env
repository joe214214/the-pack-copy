# ThePack — .env template
# Copy this file to the project root as `.env` and fill in the two values.
# (.env is gitignored — each developer/deployment brings their own database.)

# ============================================================
# DATABASE — PostgreSQL (required)
# Any PostgreSQL works. Supabase free tier: Settings → Database → Connection string.
# NOTE: only the database is used. Supabase Auth is NOT used (removed 2026-06-20).
# A fresh database starts empty — run `npx prisma db push && npm run db:seed`.
# ============================================================
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres"

# ============================================================
# AUTH — session cookie signing secret (required)
# Any long random string. Changing it invalidates all existing logins.
# ============================================================
AUTH_SECRET="change_me_to_a_long_random_string"

# ============================================================
# APP CONFIG (optional)
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================
# STRIPE — future scope, not wired up yet
# ============================================================
# STRIPE_SECRET_KEY="sk_test_..."
