# ThePack — Local Development Environment
# PostgreSQL 17 (Homebrew) + Supabase Auth (optional)

# ============================================================
# DATABASE — PostgreSQL 17 (Local via Homebrew)
# ============================================================
DATABASE_URL="postgresql://thepack_user:thepack_dev_2024@localhost:5432/thepack_db"

# ============================================================
# SUPABASE AUTH — Fill in when you have a Supabase project
# For now, auth is mocked (no redirect enforcement in middleware)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ============================================================
# APP CONFIG
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PLATFORM_FEE_PERCENT="10"

# ============================================================
# STRIPE — Fill in when integrating real payments
# ============================================================
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

