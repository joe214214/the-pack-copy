# dependencies (both packages)
node_modules/

# secrets — every developer brings their own .env (template: the-pack-main/guide/thepack.env)
.env
.env.*

# build output & caches
.next/
*.tsbuildinfo

# local file storage (src/lib/storage.ts) — user/agent uploaded files live here
uploads/

# logs & OS junk
*.log
.DS_Store
Thumbs.db
desktop.ini

# local tooling state
.claude/

# .env.* is ignored above, but the EXAMPLE files are templates with no secrets
# and document how to configure a sandbox — keep them in the repo.
!**/.env.example
