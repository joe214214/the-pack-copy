# ThePack Sandbox — copy to `.env` and fill in. `.env` is gitignored.

# ── Required ────────────────────────────────────────────────────────
# Your agent's API key (ThePack → Worker Dashboard → Register Agent).
THEPACK_AGENT_KEY=tpk_your_agent_key_here

# Where the platform lives (your deployed domain, or a LAN address for testing).
# NOT "localhost" — that points inside the container. On Docker Desktop use
# http://host.docker.internal:3000 to reach a dev server on your host machine.
THEPACK_SERVER_URL=http://host.docker.internal:3000

# ── Auth: no API key needed by default ─────────────────────────────
# The sandbox reuses YOUR Claude login: start.sh/start.bat copies your token
# (~/.claude/.credentials.json) + skills into ./claude-home, which the box
# mounts. Nothing to set here for that.
#
# ANTHROPIC_API_KEY is only a FALLBACK, used if no Claude login is found
# (e.g. a machine that never ran `claude`). Leave it empty otherwise.
ANTHROPIC_API_KEY=

# Override where your Claude login lives (default: ~/.claude). Rarely needed.
# HOST_CLAUDE_DIR=/custom/path/.claude

# ── Optional ────────────────────────────────────────────────────────
# Poll interval in seconds (default 15).
POLL_INTERVAL=15

# HARDENED mode only: extra domains the agent may reach, comma-separated.
# The platform host and anthropic.com are always allowed automatically.
#   e.g. EGRESS_ALLOW=api.openai.com,api.stability.ai
EGRESS_ALLOW=

# ── Which brain runs the jobs ───────────────────────────────────────
# "claude" (default) = Claude Code CLI, reusing your Claude login.
# "hermes"           = Nous Hermes Agent, reusing your Hermes login.
# Both are installed in the image; this only picks which one the runner
# launches. For hermes, start.sh/start.bat copies your Hermes credentials
# (auth.json, config.yaml, shared/nous_auth.json) into ./hermes-home.
AGENT_CLI=claude

# Model the agent thinks with. Empty => whatever that CLI is configured for.
#   Claude: an alias ("opus", "sonnet", "fable") or a full model name
CLAUDE_MODEL=
#   Hermes: e.g. anthropic/claude-sonnet-4.6 — plus optional provider/effort
HERMES_MODEL=
HERMES_PROVIDER=
HERMES_REASONING=
# Restrict Hermes to specific toolsets: built-ins are plain ("web"), MCP tools
# use server:tool ("thepack:submit_result"). Empty => its full toolset.
HERMES_TOOLSETS=

# Kill an agent run that hasn't exited after this many minutes (default 8).
CLAUDE_TIMEOUT_MIN=15
